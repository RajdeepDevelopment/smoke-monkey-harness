{
  "name": "smoke-monkey-harness",
  "version": "1.0.5",
  "description": "Build agentic tools, AI code editors, and agent harnesses in a few lines. Framework-agnostic TypeScript agent loop with MCP (Model Context Protocol) client, just-in-time SKILL.md skills, permissions, and LLM providers — behind the Smoke Monkey code editor.",
  "license": "MIT",
  "author": {
    "name": "Rajdeep Development",
    "url": "https://github.com/RajdeepDevelopment"
  },
  "homepage": "https://github.com/RajdeepDevelopment/smoke-monkey-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajdeepDevelopment/smoke-monkey-harness.git"
  },
  "bugs": {
    "url": "https://github.com/RajdeepDevelopment/smoke-monkey-harness/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js",
      "require": "./dist/cjs/harness.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'tests/*.test.ts'",
    "test:fixtures": "tsx scripts/fixtures/test-manager.ts && tsx scripts/fixtures/test-integration.ts && tsx scripts/fixtures/test-skills.ts && tsx scripts/fixtures/test-plugin-mcp.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "tsx examples/basic-agent.ts",
    "demo": "tsx examples/mcp-demo.ts",
    "demo:skills": "tsx examples/skills-demo.ts",
    "demo:plugin": "tsx examples/plugin-demo.ts",
    "plugin:install": "bash plugin/install.sh",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "keywords": [
    "agent",
    "ai",
    "ai-agent",
    "ai-agents",
    "code-editor",
    "llm",
    "tool-use",
    "tool-calling",
    "harness",
    "agentic",
    "mcp",
    "model-context-protocol",
    "skills",
    "agent-framework",
    "claude-code",
    "codex",
    "opencode",
    "typescript"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1"
  }
}