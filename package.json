{
  "name": "@smoke-monkey/harness",
  "version": "0.1.0",
  "description": "Build agentic tools, AI code editors, and agent harnesses in a few lines — the agent loop, tools, permissions, and LLM client behind the Smoke Monkey code editor.",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js",
      "require": "./dist/cjs/harness.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx examples/basic-agent.ts",
    "demo": "tsx examples/mcp-demo.ts",
    "test:fixtures": "tsx scripts/fixtures/test-manager.ts && tsx scripts/fixtures/test-integration.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "code-editor",
    "llm",
    "tool-use",
    "harness",
    "agentic"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}