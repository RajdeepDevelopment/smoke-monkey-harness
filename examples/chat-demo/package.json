{
  "name": "smoke-monkey-chat-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A friendly, runnable demo for the @smoke-monkey/ui chat component. No backend, no keys — just install and run.",
  "scripts": {
    "predev": "cd ../../ui && pnpm build",
    "dev": "vite",
    "prebuild": "cd ../../ui && pnpm build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.5.4",
    "vite": "^6.3.5"
  }
}