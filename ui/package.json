{
  "name": "@smoke-monkey/ui",
  "version": "0.1.1",
  "description": "Drop-in React chat UI for AI agents and LLMs. Streaming markdown, tool-call cards, charts, mermaid diagrams, syntax highlighting and inline ask-user prompts, with a headless runtime and a normalized event contract. Works with OpenAI, Anthropic, Gemini, LangGraph, MCP or your own agent.",
  "keywords": [
    "ai",
    "ai-chat",
    "chat",
    "chat-ui",
    "llm",
    "llm-ui",
    "agent",
    "agent-ui",
    "agentic",
    "streaming",
    "sse",
    "websocket",
    "markdown",
    "codeblock",
    "mermaid",
    "charts",
    "tool-calling",
    "react",
    "typescript",
    "ui",
    "components",
    "openai",
    "anthropic",
    "gemini",
    "langgraph",
    "mcp",
    "smoke-monkey"
  ],
  "license": "MIT",
  "author": {
    "name": "Rajdeep Development",
    "url": "https://github.com/RajdeepDevelopment"
  },
  "homepage": "https://smoke-monkey-harness.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajdeepDevelopment/smoke-monkey-harness.git"
  },
  "bugs": {
    "url": "https://github.com/RajdeepDevelopment/smoke-monkey-harness/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ui.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm build:ts && pnpm build:css",
    "build:ts": "tsup",
    "build:css": "sass --silence-deprecation=import ./src/styles/index.scss ./src/index.css && postcss ./src/index.css -o ./dist/index.css",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.105.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.4.0",
    "typescript": "^5.5.4"
  }
}
